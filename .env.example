# Copy to .env (npm run setup does this automatically if .env is missing).
DATABASE_URL="file:./dev.db"

# Integration config. All adapters are mocked in this prototype; real adapters would read these.
INTEGRATIONS_MODE="mock"
KYC_VENDOR_API_URL="https://kyc-vendor.example.com"
KYC_VENDOR_API_KEY="replace-me"
PAYMENTS_API_URL="https://payments.example.com"
PAYMENTS_API_KEY="replace-me"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/replace-me"
SLACK_DEFAULT_CHANNEL="#kyc-ops"
