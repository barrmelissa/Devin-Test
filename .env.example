# Copy to .env (npm run setup does this automatically if .env is missing).
DATABASE_URL="file:./dev.db"

# AES-256-GCM key (32 bytes, base64) for sensitive fields at rest, e.g. KYC tax IDs.
# npm run setup generates one if empty. In production, load from a KMS / secrets manager.
FIELD_ENCRYPTION_KEY=""

# Bearer token the onboarding system uses for POST /api/kyc/intake (service account "Onboarding system").
# npm run setup generates one if empty.
ONBOARDING_SERVICE_TOKEN=""

# Integration config. All adapters are mocked in this prototype; real adapters would read these.
INTEGRATIONS_MODE="mock"
KYC_VENDOR_API_URL="https://kyc-vendor.example.com"
KYC_VENDOR_API_KEY="replace-me"
PAYMENTS_API_URL="https://payments.example.com"
PAYMENTS_API_KEY="replace-me"
FLAG_SERVICE_API_URL="https://flags.example.com"
FLAG_SERVICE_API_KEY="replace-me"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/replace-me"
SLACK_DEFAULT_CHANNEL="#kyc-ops"
