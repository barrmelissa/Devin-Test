// SQLite for the prototype. Kept Postgres-compatible: no enums (statuses/roles are
// validated in code) and JSON is stored as text, so switching the provider is a one-line change.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  String // see src/foundation/access/roles.ts

  assignedKycCases  KycCase[] @relation("KycAssignedAnalyst")
  submittedKycCases KycCase[] @relation("KycSubmittedBy")
  requestedRefunds  RefundRequest[] @relation("RefundRequestedBy")
  approvedRefunds   RefundRequest[] @relation("RefundApprovedBy")

  changedFeatureFlags      FeatureFlag[] @relation("FlagLastChangedBy")
  requestedFlagProdChanges FeatureFlag[] @relation("FlagProdChangeRequestedBy")
}

// Append-only. The foundation exposes no update/delete path for this table.
// Actor name/role are denormalised so entries stay accurate if a user changes later.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  actorRole  String
  app        String
  entityType String
  entityId   String
  action     String
  before     String? // JSON
  after      String? // JSON
  createdAt  DateTime @default(now())

  @@index([app])
  @@index([actorId])
  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  channel   String
  message   String
  app       String
  entityId  String?
  createdAt DateTime @default(now())
}

// ---- App: KYC review queue ----
model KycCase {
  id                String    @id @default(cuid())
  customerName      String
  country           String
  riskScore         Int
  taxId             String
  status            String    @default("new")
  assignedAnalystId String?
  assignedAnalyst   User?     @relation("KycAssignedAnalyst", fields: [assignedAnalystId], references: [id])
  submittedById     String?
  submittedBy       User?     @relation("KycSubmittedBy", fields: [submittedById], references: [id])
  recommendation    String? // approve | reject
  vendorResult      String? // pass | fail | review
  vendorReason      String?
  vendorCheckedAt   DateTime?
  notes             String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([assignedAnalystId])
}

// ---- App: Refunds dashboard ----
// Money is stored in integer cents. requestedById is the workflow's maker (maker-checker).
model RefundRequest {
  id                  String    @id @default(cuid())
  customerName        String
  transactionId       String
  originalAmountCents Int
  refundAmountCents   Int
  currency            String    @default("USD")
  reason              String // duplicate_charge | fraud | service_issue | other
  notes               String    @default("")
  status              String    @default("submitted")
  requestedById       String
  requestedBy         User      @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?     @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  autoApproved        Boolean   @default(false)
  providerStatus      String? // succeeded | failed
  providerRefundId    String?
  providerMessage     String?
  processedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([requestedById])
}

// ---- App: Feature-flag admin ----
// The pending prod change request lives on the flag (one at a time): prodChangeStatus is the
// workflow status and prodChangeRequestedById the maker, so every request/decision is audited
// on the flag itself with full before/after values.
model FeatureFlag {
  id                        String    @id @default(cuid())
  key                       String    @unique
  description               String
  ownerTeam                 String
  devEnabled                Boolean   @default(false)
  stagingEnabled            Boolean   @default(false)
  prodEnabled               Boolean   @default(false)
  prodRolloutPercent        Int       @default(0)
  prodChangeStatus          String    @default("none") // none | pending | approved | rejected
  pendingProdEnabled        Boolean?
  pendingProdRolloutPercent Int?
  prodChangeReason          String?
  prodChangeRequestedById   String?
  prodChangeRequestedBy     User?     @relation("FlagProdChangeRequestedBy", fields: [prodChangeRequestedById], references: [id])
  prodChangeRequestedAt     DateTime?
  flagServiceChangeId       String?
  lastChangedById           String
  lastChangedBy             User      @relation("FlagLastChangedBy", fields: [lastChangedById], references: [id])
  lastChangedAt             DateTime  @default(now())
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([prodChangeStatus])
  @@index([ownerTeam])
}
